# Offline, deterministic demo by default. No credentials required.
AI_PROVIDER=mock
DATABASE_URL=sqlite:///./data/workflows.db
# Required only for AI_PROVIDER=openai; must support Chat Completions json_schema.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=0.5
# Optional locally; required when APP_ENV=production. Use a long random value.
API_KEY=
APP_ENV=development
